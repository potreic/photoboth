# Supabase project (used for Realtime signaling, and later Storage/DB)
# https://supabase.com/dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# TURN relay, only needed when direct P2P fails (symmetric NAT, some mobile
# networks). Free tier: https://www.metered.ca/tools/openrelay/ or Xirsys.
# Leave blank to run STUN-only while testing on friendly networks.
NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=
